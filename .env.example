# Local demo settings (copy to .env). These are the mock APIs' demo credentials,
# not real secrets. In the cloud every secret comes from Secret Manager.
HOSPITALITY_ENV=local
LOCAL_DATA_DIR=.local
POS_BASE_URL=http://127.0.0.1:8080/pos
WORKFORCE_BASE_URL=http://127.0.0.1:8080/workforce
LOCAL_SFTP_DIR=mock_sources/sftp_drop

POS_CLIENT_ID=demo-client
POS_CLIENT_SECRET=demo-secret
WORKFORCE_API_KEY=demo-workforce-key
PII_HMAC_KEY=local-dev-only-key
WEBHOOK_SECRET_POS=local-webhook-secret
